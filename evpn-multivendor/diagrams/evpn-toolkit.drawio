<mxfile host="drawio"><diagram name="Toolkit" id="toolkit"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="The EVPN toolkit this lab exercises" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="700" height="36" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;Type-3 · Inclusive multicast&lt;/b&gt;&lt;br&gt;&lt;i&gt;&quot;I am a VTEP for VNI 10010&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Builds the flood list: who gets a copy of a broadcast or unknown frame (ingress replication)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;Seen in:&lt;/b&gt; scenario 1, three copies of one ARP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Type-2 · MAC/IP advertisement&lt;/b&gt;&lt;br&gt;&lt;i&gt;&quot;50:01:00:08:00:00 / 10.10.10.108 is behind VTEP 10.0.0.5&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Bridging without flooding, ARP suppression, /32 host routes, host moves&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;Seen in:&lt;/b&gt; scenarios 1, 2 and 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=5;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="50" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="r5" value="&lt;b&gt;Type-5 · IP prefix&lt;/b&gt;&lt;br&gt;&lt;i&gt;&quot;10.30.30.0/24 is behind VTEP 10.0.1.10&quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Reaches a subnet before any host in it has been learned&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;Seen in:&lt;/b&gt; scenario 2, the cold destination&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacing=10;arcSize=5;" vertex="1" parent="1"><mxGeometry x="660" y="50" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="attrs" value="Attributes carried with the routes" style="swimlane;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;html=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="940" height="125" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;Route target&lt;/b&gt;&lt;br&gt;who imports the route&lt;br&gt;&lt;font color=&quot;#B20000&quot;&gt;scenario 4b&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="attrs"><mxGeometry x="15" y="40" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;Two labels&lt;/b&gt;&lt;br&gt;L2 VNI 10010 + L3VNI 50001&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;scenario 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="attrs"><mxGeometry x="245" y="40" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="a3" value="&lt;b&gt;Router MAC&lt;/b&gt;&lt;br&gt;inner destination MAC for routed traffic&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;scenario 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="attrs"><mxGeometry x="475" y="40" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="a4" value="&lt;b&gt;MAC Mobility&lt;/b&gt;&lt;br&gt;sequence number: the latest location wins&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;scenario 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="attrs"><mxGeometry x="705" y="40" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="dp" value="Data plane: VXLAN" style="swimlane;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;html=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="365" width="940" height="105" as="geometry"/></mxCell>
<mxCell id="pk" value="&lt;table style=&quot;border-collapse:collapse;font-size:13px&quot; cellpadding=&quot;6&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;border:1px solid #6c8ebf&quot;&gt;outer Ethernet 14&lt;/td&gt;&lt;td style=&quot;background:#dae8fc;border:1px solid #6c8ebf&quot;&gt;outer IPv4 20&lt;br&gt;VTEP → VTEP&lt;/td&gt;&lt;td style=&quot;background:#dae8fc;border:1px solid #6c8ebf&quot;&gt;UDP 8&lt;br&gt;dst port 4789&lt;/td&gt;&lt;td style=&quot;background:#fff2cc;border:1px solid #d6b656&quot;&gt;VXLAN 8&lt;br&gt;24-bit VNI&lt;/td&gt;&lt;td style=&quot;background:#ffffff;border:1px solid #82b366&quot;&gt;original Ethernet frame&lt;br&gt;(host MACs, or router MACs when routed)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;font style=&quot;font-size:12px&quot;&gt;50 bytes added in front of every frame: &lt;b&gt;scenario 4a&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="dp"><mxGeometry x="15" y="32" width="910" height="68" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
