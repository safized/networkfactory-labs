<mxfile host="drawio"><diagram name="Scenario 2 (web)" id="s2w"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="h7" value="&lt;b&gt;SERVER-7&lt;/b&gt; · 10.20.20.107 · VLAN 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="l4" value="&lt;b&gt;LEAF-4&lt;/b&gt; (Cumulus)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;TENANT1: 10.30.30.111/32 via 10.0.1.10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="lb" value="&lt;b&gt;LEAF-BORDER&lt;/b&gt; (NX-OS)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;TENANT1: 10.20.20.107/32 via 10.0.0.4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="h11" value="&lt;b&gt;SERVER-11&lt;/b&gt; · 10.30.30.111 · VLAN 30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="e1" value="routed hop 1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h7" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="VXLAN&lt;br&gt;VNI 50001" style="endArrow=classic;html=1;strokeWidth=5;strokeColor=#d79b00;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="lb"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="routed hop 2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lb" target="h11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="f1" value="&lt;b&gt;Access port&lt;/b&gt;&lt;br&gt;Eth 50:01:00:07:00:00 → &lt;font color=&quot;#2D7600&quot;&gt;&lt;b&gt;00:00:5e:00:01:01&lt;/b&gt;&lt;/font&gt; (anycast gateway)&lt;br&gt;IP 10.20.20.107 → 10.30.30.111 · TTL &lt;b&gt;64&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;align=left;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="420" height="80" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;Interconnect&lt;/b&gt;&lt;br&gt;Outer IP 10.0.0.4 → 10.0.1.10, UDP 4789&lt;br&gt;VXLAN &lt;font color=&quot;#b46504&quot;&gt;&lt;b&gt;VNI 50001&lt;/b&gt;&lt;/font&gt; (the tenant's L3 VNI)&lt;br&gt;Inner Eth &lt;b&gt;LEAF-4 router MAC → LEAF-BORDER router MAC&lt;/b&gt;&lt;br&gt;50:00:00:04:00:08 → 50:0a:00:00:1b:08 · inner TTL &lt;b&gt;63&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="235" width="420" height="125" as="geometry"/></mxCell>
<mxCell id="f3" value="&lt;b&gt;Access port&lt;/b&gt;&lt;br&gt;Eth 50:0a:00:00:1b:08 → 50:01:00:0b:00:00&lt;br&gt;IP 10.20.20.107 → 10.30.30.111 · TTL &lt;b&gt;62&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;align=left;spacing=10;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="420" height="80" as="geometry"/></mxCell>
<mxCell id="cp" value="&lt;b&gt;Where the inner MACs come from:&lt;/b&gt; every host route is an EVPN type-2 with &lt;b&gt;two labels&lt;/b&gt; (L2 VNI + L3 VNI 50001), two route targets and a &lt;b&gt;Router MAC&lt;/b&gt; community. LEAF-BORDER has no VLAN 20, so it uses only the routed half: a /32 in TENANT1 and LEAF-4's router MAC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;spacing=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="780" height="80" as="geometry"/></mxCell>
<mxCell id="cold" value="&lt;b&gt;Cold destination:&lt;/b&gt; if LEAF-BORDER has no ARP entry for SERVER-11, LEAF-4 has only the /24 type-5 route, LEAF-BORDER must ARP and &lt;font color=&quot;#B20000&quot;&gt;&lt;b&gt;the first packet is dropped&lt;/b&gt;&lt;/font&gt;. After that, a /32 type-2 route takes every later packet straight through." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacing=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="735" width="780" height="80" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
