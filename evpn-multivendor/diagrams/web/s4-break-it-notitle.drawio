<mxfile host="drawio"><diagram name="Scenario 4" id="s4"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="ma" value="4a · Interconnect MTU 1500" style="swimlane;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;html=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="800" height="330" as="geometry"/></mxCell>
<mxCell id="pk" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px&quot; cellpadding=&quot;4&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc&quot;&gt;outer Eth 14&lt;/td&gt;&lt;td style=&quot;background:#dae8fc&quot;&gt;outer IP 20&lt;/td&gt;&lt;td style=&quot;background:#dae8fc&quot;&gt;UDP 8&lt;/td&gt;&lt;td style=&quot;background:#fff2cc&quot;&gt;VXLAN 8&lt;/td&gt;&lt;td style=&quot;background:#d5e8d4&quot;&gt;inner Eth 14 + host IP packet 1500&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;b&gt;1500-byte host packet = 1550 bytes on the underlay&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="ma"><mxGeometry x="10" y="40" width="780" height="70" as="geometry"/></mxCell>
<mxCell id="ok" value="&lt;b&gt;Still working&lt;/b&gt;&lt;br&gt;pings up to 1428 bytes&lt;br&gt;BGP on the same link (no flap)&lt;br&gt;interface errors and drops: 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacing=8;" vertex="1" parent="ma"><mxGeometry x="10" y="120" width="380" height="100" as="geometry"/></mxCell>
<mxCell id="bad" value="&lt;b&gt;Dead&lt;/b&gt;&lt;br&gt;pings of 1500 bytes: 100% loss&lt;br&gt;TCP transfer: 0 bytes&lt;br&gt;no ICMP &quot;fragmentation needed&quot;, so PMTUD cannot help" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacing=8;" vertex="1" parent="ma"><mxGeometry x="410" y="120" width="380" height="100" as="geometry"/></mxCell>
<mxCell id="how" value="&lt;b&gt;Where the packets went&lt;/b&gt;&lt;br&gt;• LEAF-3 as the VTEP: never sent&lt;br&gt;• LEAF-3 as a router: outer packet split into 1514 + 84 bytes (the outer DF bit is clear), the NX-OS VTEP never reassembles it&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; MTU ≥ host MTU + 50 on every underlay link, both ends, and test it with &lt;i&gt;ping -M do -s 1472&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=8;" vertex="1" parent="ma"><mxGeometry x="10" y="235" width="780" height="85" as="geometry"/></mxCell>
<mxCell id="mb" value="4b · Automatic route targets on Cumulus" style="swimlane;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;html=1;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="800" height="335" as="geometry"/></mxCell>
<mxCell id="cl" value="&lt;b&gt;Cumulus leaves&lt;/b&gt;&lt;br&gt;export &lt;b&gt;own-ASN:VNI&lt;/b&gt;&lt;br&gt;65103:10010, 65105:10010&lt;br&gt;import &lt;b&gt;*:10010&lt;/b&gt; (wildcard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="mb"><mxGeometry x="10" y="45" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="nx" value="&lt;b&gt;NX-OS leaves&lt;/b&gt;&lt;br&gt;export 65000:10010&lt;br&gt;import exactly &lt;b&gt;65000:10010&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="mb"><mxGeometry x="540" y="45" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="e1" value="65103:10010 ✗ not imported" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;fontColor=#B20000;fontSize=12;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="mb" source="cl" target="nx"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
<mxCell id="e2" value="65000:10010 ✓ imported" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontColor=#2D7600;fontSize=12;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="mb" source="nx" target="cl"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="14" as="offset"/></mxGeometry></mxCell>
<mxCell id="r2" value="&lt;b&gt;Result: a one-way failure&lt;/b&gt;&lt;br&gt;• inside Cumulus: still works (wildcard import)&lt;br&gt;• NX-OS: the routes are in BGP but none reach the L2RIB; Cumulus to NX-OS pings 100% loss&lt;br&gt;• Cumulus still learns NX-OS hosts, so half the tables look right&lt;br&gt;&lt;b&gt;Fix:&lt;/b&gt; in a multi-vendor eBGP fabric, set route targets explicitly and identically on every leaf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=8;" vertex="1" parent="mb"><mxGeometry x="10" y="180" width="780" height="140" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
