<mxCell id="mv" value="move: port down here, gratuitous ARP there" style="curved=1;endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=3;fontSize=14;fontStyle=1;" edge="1" parent="1" source="h8" target="h8n"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="25" as="offset"/></mxGeometry></mxCell>
<mxCell id="s0" value="&lt;b&gt;0 · at home&lt;/b&gt;&lt;br&gt;LEAF-5 advertises MAC+IP&lt;br&gt;no MAC Mobility community&lt;br&gt;(sequence 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="250" height="115" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;1 · moved to NX-OS&lt;/b&gt;&lt;br&gt;NX-LEAF-01 learns it locally and advertises &lt;b&gt;MM sequence 1&lt;/b&gt;: higher than anything seen, so every leaf prefers it. LEAF-5 withdraws in 0.27 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="320" width="260" height="115" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;2 · back on Cumulus&lt;/b&gt;&lt;br&gt;LEAF-5 advertises &lt;b&gt;MM sequence 2&lt;/b&gt;; NX-LEAF-01 withdraws in 0.03 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="320" width="250" height="115" as="geometry"/></mxCell>
<mxCell id="x1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="res" value="&lt;b&gt;Measured&lt;/b&gt; (pings every 100 ms from SERVER-6 on Cumulus and CLIENT-16 on NX-OS): &lt;b&gt;900 ms&lt;/b&gt; lost on the move to NX-OS, &lt;b&gt;700 ms&lt;/b&gt; on the move back, identical from both fabrics." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="455" width="800" height="60" as="geometry"/></mxCell>
<mxCell id="dad" value="&lt;b&gt;Flapping&lt;/b&gt;: eight moves in 40 s and both vendors flag a duplicate host (Cumulus default: 5 moves in 180 s). A loop or two hosts sharing a MAC look exactly like this. Detection raises the alarm; only freezing (off by default on Cumulus) stops the churn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="800" height="75" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
