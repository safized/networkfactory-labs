<mxCell id="n1" value="&lt;b&gt;NX-LEAF-01&lt;/b&gt; (NX-OS)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;VTEP 10.0.1.11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="200" height="60" as="geometry"/></mxCell>
