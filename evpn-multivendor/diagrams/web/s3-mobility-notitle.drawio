<mxCell id="h8n" value="&lt;b&gt;same MAC, same IP&lt;/b&gt;&lt;br&gt;after the move" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="625" y="190" width="150" height="64" as="geometry"/></mxCell>
