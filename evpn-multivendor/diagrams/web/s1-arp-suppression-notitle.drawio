<mxCell id="tbl" value="&lt;table style=&quot;border-collapse:collapse;font-size:14px&quot; cellpadding=&quot;5&quot;&gt;&lt;tr style=&quot;background:#f5f5f5&quot;&gt;&lt;th align=&quot;left&quot;&gt;Phase&lt;/th&gt;&lt;th&gt;ARP from SERVER-6&lt;br&gt;crossing the link&lt;/th&gt;&lt;th&gt;ARP from CLIENT-16&lt;br&gt;crossing the link&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;a&lt;/b&gt; silent host, NX-OS suppression off&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;&lt;font color=&quot;#B20000&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;b&lt;/b&gt; host spoke once, NX-OS suppression off&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;&lt;font color=&quot;#2D7600&quot;&gt;&lt;b&gt;0&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;&lt;font color=&quot;#B20000&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;c&lt;/b&gt; suppression on both vendors&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;&lt;font color=&quot;#2D7600&quot;&gt;&lt;b&gt;0&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;&lt;font color=&quot;#2D7600&quot;&gt;&lt;b&gt;0&lt;/b&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#d6b656;fillColor=#fffdf3;rounded=1;arcSize=4;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="780" height="150" as="geometry"/></mxCell>
<mxCell id="note" value="&lt;b&gt;The lesson&lt;/b&gt;&lt;br&gt;Suppression answers only from the EVPN MAC+IP table. A silent host has no entry, so its first ARP is flooded whatever you configure. Suppression must be on at the leaf where the ARP arrives: on NX-OS that means a TCAM carve and a reload first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="780" height="95" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
