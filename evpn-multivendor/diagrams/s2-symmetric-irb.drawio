<mxfile host="drawio"><diagram name="Scenario 2" id="s2"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Scenario 2: one routed packet, two vendors (symmetric IRB)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="36" as="geometry"/></mxCell>
<mxCell id="h7" value="&lt;b&gt;SERVER-7&lt;/b&gt;&lt;br&gt;10.20.20.107&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;VLAN 20&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="140" height="70" as="geometry"/></mxCell>
<mxCell id="l4" value="&lt;b&gt;LEAF-4&lt;/b&gt; (Cumulus)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;route in TENANT1:&lt;br&gt;10.30.30.111/32 via 10.0.1.10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="lb" value="&lt;b&gt;LEAF-BORDER&lt;/b&gt; (NX-OS)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;route in TENANT1:&lt;br&gt;10.20.20.107/32 via 10.0.0.4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="h11" value="&lt;b&gt;SERVER-11&lt;/b&gt;&lt;br&gt;10.30.30.111&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;VLAN 30&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="140" height="70" as="geometry"/></mxCell>
<mxCell id="e1" value="routed hop 1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="h7" target="l4"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
<mxCell id="e2" value="VXLAN, VNI 50001 (L3VNI)" style="endArrow=classic;html=1;strokeWidth=4;strokeColor=#d79b00;fontSize=12;fontStyle=1;" edge="1" parent="1" source="l4" target="lb"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
<mxCell id="e3" value="routed hop 2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="lb" target="h11"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell>
<mxCell id="f1" value="&lt;b&gt;On the access port&lt;/b&gt;&lt;br&gt;Eth 50:01:00:07:00:00 → &lt;font color=&quot;#2D7600&quot;&gt;&lt;b&gt;00:00:5e:00:01:01&lt;/b&gt;&lt;/font&gt;&lt;br&gt;(the anycast gateway)&lt;br&gt;IP 10.20.20.107 → 10.30.30.111&lt;br&gt;TTL &lt;b&gt;64&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;align=left;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;On the interconnect&lt;/b&gt;&lt;br&gt;Outer IP 10.0.0.4 → 10.0.1.10, UDP 4789&lt;br&gt;VXLAN &lt;font color=&quot;#b46504&quot;&gt;&lt;b&gt;VNI 50001&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Inner Eth &lt;b&gt;50:00:00:04:00:08 → 50:0a:00:00:1b:08&lt;/b&gt;&lt;br&gt;(LEAF-4 router MAC → LEAF-BORDER router MAC)&lt;br&gt;Inner TTL &lt;b&gt;63&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="f3" value="&lt;b&gt;On the access port&lt;/b&gt;&lt;br&gt;Eth 50:0a:00:00:1b:08 → 50:01:00:0b:00:00&lt;br&gt;IP 10.20.20.107 → 10.30.30.111&lt;br&gt;TTL &lt;b&gt;62&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;align=left;spacing=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="cp" value="&lt;b&gt;Where the inner MACs come from&lt;/b&gt;: each leaf advertises its host routes as EVPN type-2 with &lt;b&gt;two labels&lt;/b&gt; (L2 VNI 10020 + L3VNI 50001), two route targets (65000:10020 + 65000:50001) and a &lt;b&gt;Router MAC&lt;/b&gt; extended community. LEAF-BORDER has no VLAN 20, so it uses only the L3 half: a /32 in TENANT1 and LEAF-4's router MAC." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;spacing=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1060" height="70" as="geometry"/></mxCell>
<mxCell id="cold" value="&lt;b&gt;Cold destination&lt;/b&gt; (LEAF-BORDER has no ARP entry for SERVER-11): LEAF-4 has only the 10.30.30.0/24 type-5 route, LEAF-BORDER must ARP, and the &lt;font color=&quot;#B20000&quot;&gt;&lt;b&gt;first packet is dropped&lt;/b&gt;&lt;/font&gt;. Once SERVER-11 answers, LEAF-BORDER advertises a /32 type-2 route and every later packet goes straight through." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacing=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1060" height="60" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
